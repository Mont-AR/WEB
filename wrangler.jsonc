// Cloudflare Workers (con assets estáticos): configuración del proyecto para Wrangler.
// - El sitio es estático: `npm run build` lo deja en dist/, y Cloudflare sirve esos archivos directo
//   (assets), sin ejecutar código ni contar como pedidos al Worker.
// - Solo /api/* pasa por el Worker (worker/index.ts): /api/contact atiende el formulario (worker/contact.ts).
// - Probar todo junto en local: `npm run cf:dev`. Deployar a mano: `npm run cf:deploy`.
//
// Deploy desde git (Workers & Pages → montar-web → Settings → Build):
//   - Build command: `npm run build` · Deploy command: `npx wrangler deploy`
//   - Production branch: la que publica montivero.ar (p. ej. main).
//   - Non-production branch builds: activarlo para que las demás branches (astro, pruebas...) se suban
//     como versiones de prueba, cada una con su URL de preview, sin tocar producción. Su comando de
//     deploy: `npx wrangler versions upload`.
//
// Secretos: la clave de Resend NO va acá. RESEND_API_KEY se carga en Workers & Pages → montar-web →
//   Settings → Variables and Secrets, como tipo "Secret" (vale para producción y previews), o con
//   `npx wrangler secret put RESEND_API_KEY`. (El remitente es fijo, en worker/contact.ts.) En local: .dev.vars o .env (los dos están en .gitignore).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // nombre del Worker en Cloudflare: tiene que ser el mismo que el del proyecto en el panel
  "name": "montar-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",

  "assets": {
    "directory": "./dist",
    // así el Worker puede pasarle a los assets todo lo que no es /api (env.ASSETS)
    "binding": "ASSETS",
    // solo estas rutas ejecutan el Worker; el resto se sirve directo desde dist/
    "run_worker_first": ["/api/*"]
  },

  // variables públicas (no secretas) disponibles en el Worker como env.NOMBRE. Con este archivo en el
  // repo se manejan desde acá: lo que se cambie en el panel se pisa en el próximo deploy.
  "vars": {
    "CONTACT_TO_EMAIL": "desarrollo@montivero.ar"
  },

  // logs del Worker en el panel (Workers Logs): ahí aparecen los errores del formulario, como el código
  // con el que Resend rechazó un envío. No guardan los datos que escribe la gente.
  "observability": { "enabled": true },

  // URLs de preview para las versiones de las branches que no son producción
  "preview_urls": true,
  "previews": {}
}
