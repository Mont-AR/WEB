// Cloudflare Pages: configuración del proyecto para Wrangler (deploy y pruebas locales).
// - El sitio es estático: `npm run build` lo deja en dist/ (pages_build_output_dir).
// - functions/ (en la raíz) son las funciones del sitio: functions/api/contact.ts atiende POST /api/contact.
//   Cloudflare las detecta solas; no hace falta declararlas acá.
// - Probar todo junto en local: `npm run cf:dev`. Deployar: `npm run cf:deploy` (deploya la branch de git
//   actual: si es la de producción va a Production, si no a Preview).
//
// Branches: QUÉ branches se deployan no se configura en este archivo sino en el panel:
//   Pages → Settings → Builds → Branch control
//   - Production branch: la que publica montivero.ar (p. ej. main).
//   - Preview branches: "All non-Production branches" (todas, como astro) o solo las que se elijan.
// Cada deploy de una branch que no es la de producción cae en el entorno "preview" y queda en
// https://<branch>.montar.pages.dev (astro → https://astro.montar.pages.dev).
//
// Secretos: la clave de Resend y el remitente NO van acá. RESEND_API_KEY y CONTACT_FROM_EMAIL se cargan en
//   Pages → Settings → Variables and Secrets, en Production Y en Preview (si no, el formulario de las
//   branches responde "no configurado"), o con `npx wrangler pages secret put NOMBRE [--env preview]`.
//   En local: .dev.vars o .env (los dos están en .gitignore).
//
// Con este archivo en el repo, las variables de "vars" se manejan desde acá y no desde el panel.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // nombre del proyecto en Cloudflare Pages (cambiarlo si el proyecto se llama distinto)
  "name": "montar",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-01",

  // variables públicas (no secretas) disponibles en las funciones como env.NOMBRE. Las de arriba valen
  // para local; cada entorno de Cloudflare tiene las suyas abajo ("vars" no se hereda: se repite entera).
  "vars": {
    "CONTACT_TO_EMAIL": "desarrollo@montivero.ar"
  },
  "env": {
    // la branch de producción
    "production": {
      "vars": {
        "CONTACT_TO_EMAIL": "desarrollo@montivero.ar"
      }
    },
    // todas las demás branches (astro, pruebas...). Se puede mandar los avisos de prueba a otro mail.
    "preview": {
      "vars": {
        "CONTACT_TO_EMAIL": "desarrollo@montivero.ar"
      }
    }
  },
  "previews": {}
}
